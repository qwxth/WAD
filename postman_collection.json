{
  "info": {
    "name": "LoadForecast API",
    "description": "Коллекция запросов для лабораторной работы №3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": "postman_user"
    },
    {
      "key": "email",
      "value": "postman_user@example.com"
    },
    {
      "key": "password",
      "value": "secret123"
    },
    {
      "key": "pattern_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01. POST регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const u = 'user' + Date.now();",
              "pm.collectionVariables.set('username', u);",
              "pm.collectionVariables.set('email', u + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02. POST вход (login)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('cookie session_id установлена', function () { pm.expect(pm.cookies.has('session_id')).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "03. GET список с фильтром",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/load_patterns?max_expected=200&min_rps=100",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "load_patterns"
          ],
          "query": [
            {
              "key": "max_expected",
              "value": "200"
            },
            {
              "key": "min_rps",
              "value": "100"
            }
          ]
        }
      }
    },
    {
      "name": "04. POST создать паттерн (image+video)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/load_patterns",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "load_patterns"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "pattern_name",
              "value": "Test Pattern",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Описание тестового паттерна",
              "type": "text"
            },
            {
              "key": "use_case",
              "value": "Нагрузочное тестирование",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": []
            },
            {
              "key": "video",
              "type": "file",
              "src": []
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Паттерн создан', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "pm.collectionVariables.set('pattern_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05. GET черновик",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/load_patterns/draft",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "load_patterns",
            "draft"
          ]
        }
      }
    },
    {
      "name": "06. PUT публикация",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/load_patterns/{{pattern_id}}/publish",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "load_patterns",
            "{{pattern_id}}",
            "publish"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requests_per_second\": 1000,\n  \"peak_multiplier\": 2.5,\n  \"duration_hours\": 12,\n  \"description\": \"Обновлённое описание\",\n  \"base_cpu_cores\": 8,\n  \"base_ram_gb\": 16\n}"
        }
      }
    },
    {
      "name": "07. GET лента без ID (один объект)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/load_patterns/feed",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "load_patterns",
            "feed"
          ]
        }
      }
    },
    {
      "name": "08. GET лента по ID next=true",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/load_patterns/{{pattern_id}}?next=true",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "load_patterns",
            "{{pattern_id}}"
          ],
          "query": [
            {
              "key": "next",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "09. POST поставить лайк",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/load_patterns/{{pattern_id}}/like",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "load_patterns",
            "{{pattern_id}}",
            "like"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"value\": 1}"
        }
      }
    },
    {
      "name": "10. POST убрать лайк",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/load_patterns/{{pattern_id}}/like",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "load_patterns",
            "{{pattern_id}}",
            "like"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"value\": 0}"
        }
      }
    },
    {
      "name": "11. DELETE удалить паттерн",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{base_url}}/api/load_patterns/{{pattern_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "load_patterns",
            "{{pattern_id}}"
          ]
        }
      }
    },
    {
      "name": "12. POST выход (logout)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}